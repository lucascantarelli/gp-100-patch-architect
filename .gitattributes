# Normalização de fim de linha — evita que o checkout de outra máquina
# altere bytes de arquivos que vão para a pedaleira ou para o usuário final.
* text=auto

# .prst = XML que a GP-100 importa. O arquivo validado no aparelho é o export
# do GP-100 Edits com CRLF: fixe CRLF em qualquer clone (Windows/Linux/macOS).
*.prst text eol=crlf

# Documentação gerada pelo pipeline (o gerador escreve CRLF de propósito).
patches/**/*.md text eol=crlf

# Scripts de shell: SEMPRE LF. Com `core.autocrlf=true` (default do Git for
# Windows) o checkout põe CRLF e o shebang vira "#!/usr/bin/env bash\r": rodar
# `./setup_repo.sh` no Git Bash falha com erro de interpretador. O blob já era
# LF — aqui a regra garante que o arquivo em disco também seja.
*.sh text eol=lf

# VERSION é lido por `cat` (release.yml) e por read_version(): um CR sobrando
# faria "1.0.0\r" não casar com a tag v1.0.0.
VERSION text eol=lf

# Binários: nunca normalizar, nunca tentar diff de texto.
*.wav binary
*.mp3 binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
