# Páginas renderizadas do manual (regeneráveis com pymupdf)
manual_pages/

# Dependências locais
node_modules/

# Segredos
.env

# Python cache
__pycache__/
*.pyc

# Ambientes virtuais
.venv/
venv/

# Lixo de sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Estado local do Freebuff / IDEs
.freebuff/
.idea/
.vscode/

# ── Conteúdo de terceiros: NÃO versionado ──────────────────────────────────────
# Banco local de IRs: as licenças dos packs são de terceiros (a IR-Cab Library
# V3 é gratuita com cadastro no site da Origin Effects, mas a redistribuição não
# é concedida). Mantenha só o README que explica o fluxo de instalação.
impulse_responses/*
!impulse_responses/README.md

# Manual oficial da Valeton (obra de terceiro) — obtenha no site do fabricante.
# `tools/render_manual_page.py` lê este arquivo localmente.
manual.pdf

# ── Intermediário do pipeline: NÃO versionado ──────────────────────────────────
# `spec.json` é o que o `generate_prst.py` consome para gerar o `.prst`; o
# pipeline o escreve no disco a cada rodada. Ninguém o consome depois (não vai ao
# pacote de release) e ele é 100% regenerável do `patches-defs.json` — o que se
# versiona é a fonte (`patches-defs.json`) e o produto (`.prst` + `patch.md`).
patches/**/spec.json

# ── Saída de empacotamento de release ─────────────────────────────────────────
# `tools/build_release.py` escreve os ZIPs aqui; eles vão anexados à Release,
# nunca para o histórico do git.
dist/
